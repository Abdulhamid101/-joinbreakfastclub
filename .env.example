# Set these in Vercel → Project → Settings → Environment Variables.
# See SHOP-SETUP.md and ADMIN-SETUP.md. Never commit real values.

# ── Shop ──
PAYSTACK_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ORDER_ALERT_EMAIL=
RESEND_FROM=

# ── Admin (generate with: npm run admin:setup) ──
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_TOTP_SECRET=

# ── Storage (added automatically when you connect Upstash Redis in Vercel → Storage) ──
KV_REST_API_URL=
KV_REST_API_TOKEN=
